# --- required for live data -------------------------------------------------
# Register at https://opendata.met.ie, then copy the API key from your profile.
MET_API_KEY=

# --- where you are (default location in the forecast panel) ----------------
HOME_NAME=Dublin
HOME_LAT=53.3498
HOME_LON=-6.2603

# --- map ------------------------------------------------------------------------
# openfreemap (free, no key) | osm | none (bundled coastline only)
BASEMAP=openfreemap

# --- radar ------------------------------------------------------------------
RADAR_POLL_SECONDS=150
RADAR_HISTORY_MINUTES=120
# Instantaneous volume scans: T_PAGZ40 = Shannon, T_PAGZ41 = Dublin
RADAR_FILE_REGEX=T_PAGZ4[01]_.*\.h5$
# echoes weaker than this (dBZ) are hidden - raise to 10-12 if you see clutter
RADAR_MIN_DBZ=7

# --- NWP (HARMONIE-AROME GRIB) -------------------------------------------------
NWP_POLL_SECONDS=900
# Narrow this once you've seen the real file names (GET /api/debug/list/nwp)
NWP_FILE_REGEX=.*
NWP_MAX_FILE_MB=1500
# stop downloading once the raw GRIB folder reaches this size
NWP_MAX_RAW_GB=20
NWP_MAX_HOURS=60

# --- advanced -----------------------------------------------------------------
# MET_API_BASE=https://api.opendata.met.ie/api
# MET_PF_URL=http://openaccess.pf.api.met.ie/metno-wdb2ts/locationforecast
# MET_WARNINGS_URL=https://www.met.ie/Open_Data/json/warning_IRELAND.json
# DATA_DIR=./data
# INBOX_DIR=./data/inbox
